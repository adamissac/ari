{
  "$defs": {
    "ApplicationVerification": {
      "enum": [
        "unverified",
        "ingest_seen",
        "token_revoked",
        "disconnected"
      ],
      "title": "ApplicationVerification",
      "type": "string"
    },
    "ConnectedApplication": {
      "additionalProperties": false,
      "description": "Owner-registered staging app under watch. Never includes secrets.",
      "properties": {
        "control_channel_configured": {
          "default": false,
          "description": "True when a control channel exists; the HMAC secret is never returned",
          "title": "Control Channel Configured",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Created By",
          "type": "string"
        },
        "disconnected_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disconnected At"
        },
        "environment": {
          "$ref": "#/$defs/StagingEnvironment"
        },
        "id": {
          "pattern": "^app_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "ingest_configured": {
          "description": "True when a non-revoked ingest token exists; the token itself is never returned",
          "title": "Ingest Configured",
          "type": "boolean"
        },
        "last_ingest_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Ingest At"
        },
        "name": {
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Project Id",
          "type": "string"
        },
        "rl_gated_pilot": {
          "default": false,
          "description": "When true, the server enforces recommendation-only shadow mode: no grant, channel, authorize, or execute.",
          "title": "Rl Gated Pilot",
          "type": "boolean"
        },
        "shadow_mode": {
          "const": true,
          "default": true,
          "title": "Shadow Mode",
          "type": "boolean"
        },
        "verification": {
          "$ref": "#/$defs/ApplicationVerification"
        }
      },
      "required": [
        "id",
        "project_id",
        "name",
        "environment",
        "ingest_configured",
        "verification",
        "created_by",
        "created_at"
      ],
      "title": "ConnectedApplication",
      "type": "object"
    },
    "DefenseHealth": {
      "additionalProperties": false,
      "description": "Recorded timestamps for ingest and the job worker. Not a liveness verdict.",
      "properties": {
        "last_ingest_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latest runtime_windows.window_end for this project",
          "title": "Last Ingest At"
        },
        "last_runtime_event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latest monitoring event with source=runtime",
          "title": "Last Runtime Event At"
        },
        "policy_status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Policy Status",
          "type": "string"
        },
        "policy_status_reason": {
          "default": "No live policy-health producer. Shadow decisions stay NOT_EXECUTED; HTTP 200 is not policy health.",
          "maxLength": 500,
          "title": "Policy Status Reason",
          "type": "string"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Project Id",
          "type": "string"
        },
        "queue_depth": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Queued jobs; null if the queue was not readable",
          "title": "Queue Depth"
        },
        "rl_decisions": {
          "anyOf": [
            {
              "$ref": "#/$defs/RlDecisionActivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rl_runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RlRuntimeStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rl_smoke": {
          "anyOf": [
            {
              "$ref": "#/$defs/RlSmokeSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Status",
          "type": "string"
        },
        "status_reason": {
          "default": "No recorded health-check producer. Timestamps are evidence only; HTTP 200 is not a healthy verdict.",
          "maxLength": 500,
          "title": "Status Reason",
          "type": "string"
        },
        "telemetry_status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Telemetry Status",
          "type": "string"
        },
        "telemetry_status_reason": {
          "default": "Ingest timestamps are not a telemetry health verdict.",
          "maxLength": 500,
          "title": "Telemetry Status Reason",
          "type": "string"
        },
        "worker_seen_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latest jobs.heartbeat_at; null if no worker has heartbeated",
          "title": "Worker Seen At"
        },
        "worker_status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Worker Status",
          "type": "string"
        },
        "worker_status_reason": {
          "default": "No worker liveness producer. Heartbeat timestamps are evidence only.",
          "maxLength": 500,
          "title": "Worker Status Reason",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "DefenseHealth",
      "type": "object"
    },
    "PilotTrailEntry": {
      "additionalProperties": false,
      "description": "One recorded audit or ingest fact. Labels are not invented.",
      "properties": {
        "action": {
          "maxLength": 500,
          "title": "Action",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "subject_id": {
          "maxLength": 500,
          "title": "Subject Id",
          "type": "string"
        },
        "subject_type": {
          "maxLength": 500,
          "title": "Subject Type",
          "type": "string"
        }
      },
      "required": [
        "at",
        "action",
        "subject_type",
        "subject_id"
      ],
      "title": "PilotTrailEntry",
      "type": "object"
    },
    "RlDecisionActivity": {
      "additionalProperties": false,
      "properties": {
        "abstentions": {
          "description": "Decisions in the window where v6 abstained",
          "minimum": 0,
          "title": "Abstentions",
          "type": "integer"
        },
        "last_decision_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Decision At"
        },
        "last_decision_status": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Decision Status"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "recommendations": {
          "description": "Decisions in the window where v6 ran",
          "minimum": 0,
          "title": "Recommendations",
          "type": "integer"
        },
        "window_hours": {
          "const": 24,
          "default": 24,
          "title": "Window Hours",
          "type": "integer"
        }
      },
      "required": [
        "recommendations",
        "abstentions"
      ],
      "title": "RlDecisionActivity",
      "type": "object"
    },
    "RlRuntimeStatus": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "checkpoint_path": {
          "maxLength": 500,
          "title": "Checkpoint Path",
          "type": "string"
        },
        "checkpoint_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Measured sha256 of the file on disk, when it was readable",
          "title": "Checkpoint Sha256"
        },
        "label": {
          "enum": [
            "RL runtime: loaded",
            "RL runtime: not loaded"
          ],
          "title": "Label",
          "type": "string"
        },
        "loaded": {
          "title": "Loaded",
          "type": "boolean"
        },
        "mode": {
          "const": "shadow, recommendation only",
          "default": "shadow, recommendation only",
          "title": "Mode",
          "type": "string"
        },
        "pinned_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pinned Sha256",
          "type": "string"
        },
        "policy_version": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Version"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact reason the frozen v6 runner is not loaded",
          "title": "Reason"
        },
        "torch_available": {
          "title": "Torch Available",
          "type": "boolean"
        }
      },
      "required": [
        "loaded",
        "label",
        "checkpoint_path",
        "pinned_sha256",
        "torch_available",
        "checked_at"
      ],
      "title": "RlRuntimeStatus",
      "type": "object"
    },
    "RlSmokeSummary": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Availability"
        },
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "checkpoint_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Sha256"
        },
        "compromise_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compromise Rate"
        },
        "device": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "episodes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episodes"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "source_path": {
          "maxLength": 500,
          "title": "Source Path",
          "type": "string"
        },
        "steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps"
        },
        "transitions_written": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transitions Written"
        }
      },
      "required": [
        "available",
        "source_path"
      ],
      "title": "RlSmokeSummary",
      "type": "object"
    },
    "StagingEnvironment": {
      "description": "Environment an owner declares for a connected application.\n\n``production`` is a live customer system. Controls on it still need an owner grant\nand an owner's click per control; nothing executes on its own.",
      "enum": [
        "sandbox",
        "owned_test",
        "production"
      ],
      "title": "StagingEnvironment",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Exportable shadow-pilot snapshot. Not an effectiveness claim.",
  "properties": {
    "applications": {
      "items": {
        "$ref": "#/$defs/ConnectedApplication"
      },
      "title": "Applications",
      "type": "array"
    },
    "caveats": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "health": {
      "$ref": "#/$defs/DefenseHealth"
    },
    "incidents": {
      "minimum": 0,
      "title": "Incidents",
      "type": "integer"
    },
    "ingest_windows": {
      "minimum": 0,
      "title": "Ingest Windows",
      "type": "integer"
    },
    "investigation_trail": {
      "items": {
        "$ref": "#/$defs/PilotTrailEntry"
      },
      "title": "Investigation Trail",
      "type": "array"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Project Id",
      "type": "string"
    },
    "reviews": {
      "minimum": 0,
      "title": "Reviews",
      "type": "integer"
    },
    "shadow_decisions": {
      "minimum": 0,
      "title": "Shadow Decisions",
      "type": "integer"
    },
    "shadow_mode": {
      "const": true,
      "default": true,
      "title": "Shadow Mode",
      "type": "boolean"
    },
    "unsupported_claims": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Unsupported Claims",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "generated_at",
    "ingest_windows",
    "shadow_decisions",
    "reviews",
    "incidents",
    "health"
  ],
  "title": "PilotReport",
  "type": "object"
}
